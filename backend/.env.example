# Copy this file to .env and replace every value before deploying.
ADMIN_EMAIL=admin@icmt.org
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ICMT_SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated website origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://kishansaradhi.github.io
# For Render, set this as an environment variable to /var/data/icmt.db.
# ICMT_DATABASE_PATH=/var/data/icmt.db
